# AI Model (Ollama)
OLLAMA_MODEL=qwen2.5:7b

# GitHub Integration
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=owner/repo-name
GITHUB_BASE_BRANCH=main

# Local repo path (where git operations run)
REPO_LOCAL_PATH=.

# AWS (use IAM role / instance profile in production — never hardcode keys)
# AWS_DEFAULT_REGION=us-east-1
